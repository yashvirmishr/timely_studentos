# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations (service role key - keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (optional - for AI features)
# GEMINI_API_KEY=your-gemini-api-key

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX